# ── Database ──────────────────────────────────────────────────────────────
# Local Docker Postgres by default. Swap to a Neon connection string later
# (Neon requires `?sslmode=require`) — no schema changes needed.
DATABASE_URL="postgresql://alphatrade:alphatrade@localhost:5432/alphatrade"

# ── Auth (apps/api) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-64-byte-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-byte-hex-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Set to "true" in production (HTTPS). Keep "false" for local http://localhost dev.
COOKIE_SECURE="false"

# ── apps/api ─────────────────────────────────────────────────────────────
API_PORT="4000"
API_HOST="0.0.0.0"
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN="http://localhost:3010"

# ── apps/web ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── services/market-data ─────────────────────────────────────────────────
# Public Binance market-data streams — no API key required (read-only, no
# account access). Do not put exchange API keys here; those are Phase 9
# (exchange_connections, trade + read-only permissions, no withdrawals).
MARKET_DATA_PORT="4100"
MARKET_DATA_HOST="0.0.0.0"
BINANCE_WS_BASE_URL="wss://stream.binance.com:9443"
BINANCE_REST_BASE_URL="https://api.binance.com"
# Symbols to stream 1m candles for (comma-separated). The all-market ticker
# stream covers every symbol for the scanner regardless of this list.
MARKET_DATA_WATCHLIST="BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT"
MARKET_DATA_QUOTE_FILTER="USDT"

# ── apps/api -> services/market-data ────────────────────────────────────
MARKET_DATA_URL="http://localhost:4100"

# ── services/analysis-engine ─────────────────────────────────────────────
# Computes indicators/structure/regime from services/market-data's candles.
# Only meaningful for symbols in MARKET_DATA_WATCHLIST (those are the only
# ones with candle history — the scanner covers every symbol, but 1m candles
# are only streamed for the watchlist).
ANALYSIS_ENGINE_PORT="4200"
ANALYSIS_ENGINE_HOST="0.0.0.0"

# ── apps/api -> services/analysis-engine ────────────────────────────────
ANALYSIS_ENGINE_URL="http://localhost:4200"

# ── services/trading-engine ──────────────────────────────────────────────
# Strategy selection + opportunity ranking + TradeProposal generation.
# Stateless — never touches Postgres or an exchange, and never executes
# anything (that's Phase 5 risk engine -> Phase 9 execution engine).
TRADING_ENGINE_PORT="4300"
TRADING_ENGINE_HOST="0.0.0.0"

# ── apps/api -> services/trading-engine ─────────────────────────────────
TRADING_ENGINE_URL="http://localhost:4300"

# ── services/risk-engine ─────────────────────────────────────────────────
# Deterministic, independent risk rules + position sizing. Never imports the
# strategy/AI layer — only ever sees a plain TradeProposal over HTTP.
RISK_ENGINE_PORT="4400"
RISK_ENGINE_HOST="0.0.0.0"

# ── apps/api -> services/risk-engine ────────────────────────────────────
RISK_ENGINE_URL="http://localhost:4400"

# ── services/backtesting-engine ──────────────────────────────────────────
# Replays historical candles (fetched directly from Binance REST, independent
# of services/market-data's live 1m stream) through the same strategy + risk
# pipeline used live. Stateless — apps/api persists the results.
BACKTESTING_ENGINE_PORT="4500"
BACKTESTING_ENGINE_HOST="0.0.0.0"

# ── apps/api -> services/backtesting-engine ─────────────────────────────
BACKTESTING_ENGINE_URL="http://localhost:4500"

# ── Reserved for later phases (do not remove — keeps .env.example authoritative) ──
# Phase 9: AES-256-GCM key for encrypting exchange API credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
