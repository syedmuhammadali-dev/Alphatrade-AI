{
  "name": "@alphatrade/market-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@alphatrade/exchange-client": "workspace:*",
    "@alphatrade/shared-config": "workspace:*",
    "@alphatrade/shared-types": "workspace:*",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "rimraf": "^6.0.0",
    "dotenv-cli": "^7.4.2",
    "@types/node": "^22.9.0"
  }
}
